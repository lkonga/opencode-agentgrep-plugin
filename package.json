{
  "name": "@lkonga/opencode-agentgrep",
  "version": "0.3.0",
  "description": "OpenCode plugin: canonical agentgrep search (grep/find/outline/trace) with automatic native grep/glob replacement, explicit compatibility aliases, native path permissions, bounded execution, and best-effort session harness context (--context-json).",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.ts"
  },
  "files": [
    "index.ts",
    "tui.ts",
    "agentgrep-core.ts",
    "agentgrep-types.ts",
    "agentgrep-args.ts",
    "agentgrep-tools.ts",
    "agentgrep-paths.ts",
    "agentgrep-exec.ts",
    "agentgrep-guidance.ts",
    "agentgrep-context.ts",
    "agentgrep-context-schema.ts",
    "agentgrep-context-build.ts",
    "agentgrep-context-sdk.ts",
    "agentgrep-context-sqlite.ts",
    "agentgrep-context-temp.ts",
    "agentgrep-context-caps.ts",
    "agentgrep-context-bytes.ts",
    "agentgrep-context-sanitize.ts",
    "scripts/install-agentgrep.sh",
    "scripts/smoke-oc-context.sh",
    "scripts/smoke-oc-selection.sh",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkonga/opencode-agentgrep-plugin.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "test:context": "bun test agentgrep-context.test.ts",
    "smoke:context": "bash scripts/smoke-oc-context.sh",
    "smoke:selection": "bash scripts/smoke-oc-selection.sh"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.21",
    "@opencode-ai/sdk": "1.18.21"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0"
  }
}
